# Discord
DISCORD_BOT_TOKEN=
QA_FORUM_CHANNEL_ID=        # #qa-제보 포럼 채널 ID (개발자모드 → 우클릭 → ID 복사)

# 분류 모델 provider: gemini(무료티어 테스트, 기본) | anthropic(운영)
QA_MODEL_PROVIDER=gemini

# Gemini (provider=gemini일 때 필수)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Haiku (provider=anthropic일 때 필수)
ANTHROPIC_API_KEY=
HAIKU_MODEL=claude-haiku-4-5-20251001

# GitHub (이슈 생성용 fine-grained PAT, Issues:write)
GITHUB_TOKEN=
REPO_OWNER=Logos-engineers
REPO_NAME=loen-qa-bot

# 동작
MAX_ROUNDS=2               # 되묻기 최대 라운드
